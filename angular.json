{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,

  "projects": {
    "extensao-angular": {

      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",

      "architect": {

        "build": {

          "builder": "@angular/build:application",

          "options": {

            "outputPath": "dist/extensao-angular",

            "browser": "src/main.ts",

            "index": "src/index.html",

            "tsConfig": "tsconfig.app.json",

            "polyfills": [
              "zone.js"
            ],

            "assets": [
              {
                "glob": "**/*",
                "input": "src/public"
              }
            ],

            "styles": [
              "src/styles.css"
            ]
          }
        },

        "serve": {

          "builder": "@angular/build:dev-server",

          "options": {
            "buildTarget": "extensao-angular:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}